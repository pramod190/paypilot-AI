# ==============================================================================
# 🌐 APPLICATION & SERVICE URLS
# ==============================================================================

# Backend Express API Server Port & URL
PORT=4000
API_URL=http://localhost:4000

# Frontend React/Vite Client URL
CLIENT_URL=http://localhost:5173
VITE_API_BASE_URL=/api
VITE_API_URL=http://localhost:4000

# PostgreSQL connection string (create the database first, then run: npm run db:migrate)
DATABASE_URL="postgresql://postgres:password@localhost:5432/paypilot?schema=public"
# Separate database used ONLY by `npm test` (tests wipe and reseed demo data)
TEST_DATABASE_URL="postgresql://postgres:password@localhost:5432/paypilot_test?schema=public"

# Allow the one-click demo identity (set to false for a real multi-user deployment)
DEMO_LOGIN_ENABLED=true

# PayPal API Base URLs
PAYPAL_API_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_PROD_API_BASE_URL=https://api-m.paypal.com
PAYPAL_CHECKOUT_URL=https://www.sandbox.paypal.com/checkoutnow

# PayPal Checkout Return & Cancel URLs
PAYPAL_RETURN_URL=http://localhost:5173/payment/success
PAYPAL_CANCEL_URL=http://localhost:5173/payment/cancel

# ==============================================================================
# 💳 PAYPAL SANDBOX CREDENTIALS
# ==============================================================================
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret_here
PAYPAL_ENVIRONMENT=sandbox
# Required for webhooks: unverified webhook events are always rejected
PAYPAL_WEBHOOK_ID=

# ==============================================================================
# 🤖 AI MODEL CREDENTIALS & PROVIDER
# ==============================================================================
# Either GEMINI_API_KEY or OPENAI_API_KEY.
GEMINI_API_KEY=
OPENAI_API_KEY=
AI_PROVIDER=auto # "gemini" | "openai" | "auto"
# Optional model overrides (tool-calling capable models)
# GEMINI_MODEL=gemini-1.5-flash
# OPENAI_MODEL=gpt-4o-mini

# Security headers: the CSP runs in report-only mode until you set this to true.
# Click through a full Sandbox checkout on your deployed URL first, then enable it.
# CSP_ENFORCE=true

# ==============================================================================
# 🔐 SECURITY & AUTHENTICATION SECRETS
# ==============================================================================
JWT_SECRET=replace-with-a-long-random-string
SESSION_SECRET=replace-with-a-long-random-string
