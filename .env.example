# ==============================================================================
# 🌐 APPLICATION & SERVICE URLS
# ==============================================================================

# Backend Express API Server Port & URL
PORT=4000
API_URL=http://localhost:4000

# Frontend React/Vite Client URL
CLIENT_URL=http://localhost:5173
VITE_API_BASE_URL=/api
VITE_API_URL=http://localhost:4000

# Database URL (SQLite for local zero-config, or PostgreSQL)
DATABASE_URL="file:./dev.db"
# DATABASE_URL="postgresql://postgres:password@localhost:5432/paypilot?schema=public"

# PayPal API Base URLs
PAYPAL_API_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_PROD_API_BASE_URL=https://api-m.paypal.com
PAYPAL_CHECKOUT_URL=https://www.sandbox.paypal.com/checkoutnow

# PayPal Checkout Return & Cancel URLs
PAYPAL_RETURN_URL=http://localhost:5173/payment/success
PAYPAL_CANCEL_URL=http://localhost:5173/payment/cancel

# ==============================================================================
# 💳 PAYPAL SANDBOX CREDENTIALS
# ==============================================================================
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret_here
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_WEBHOOK_ID=

# ==============================================================================
# 🤖 AI MODEL CREDENTIALS & PROVIDER
# ==============================================================================
# Either GEMINI_API_KEY or OPENAI_API_KEY.
GEMINI_API_KEY=
OPENAI_API_KEY=
AI_PROVIDER=auto # "gemini" | "openai" | "auto"

# ==============================================================================
# 🔐 SECURITY & AUTHENTICATION SECRETS
# ==============================================================================
JWT_SECRET=super-secure-paypilot-secret-key-change-in-prod-2026
SESSION_SECRET=paypilot-session-token-secret
