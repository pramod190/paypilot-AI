# Server Environment
PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (SQLite by default for instant local setup, or PostgreSQL)
DATABASE_URL="file:./dev.db"
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/paypilot?schema=public"

# PayPal Sandbox Credentials (from https://developer.paypal.com/dashboard/applications/sandbox)
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret_here
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_WEBHOOK_ID=

# AI Provider Configuration (Gemini API or OpenAI API)
# Either GEMINI_API_KEY or OPENAI_API_KEY. If neither is provided, an intelligent deterministic fallback will handle parsing.
GEMINI_API_KEY=
OPENAI_API_KEY=
AI_PROVIDER=gemini # "gemini" | "openai" | "fallback"

# Security & Session
JWT_SECRET=super-secure-paypilot-secret-key-change-in-prod-2026
SESSION_SECRET=paypilot-session-token-secret

