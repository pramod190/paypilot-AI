{
  "info": {
    "name": "PayPilot AI",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run top to bottom against a local or deployed instance. PayPal checkout approval needs a human with a Sandbox buyer account; Postman covers everything up to and including order creation."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "invoiceId",
      "value": ""
    },
    {
      "key": "intentId",
      "value": ""
    },
    {
      "key": "intentVersion",
      "value": "1"
    },
    {
      "key": "orderId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Health",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "health"
          ]
        },
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200', ()=>pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Demo login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/auth/demo",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "demo"
          ]
        },
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200', ()=>pm.response.to.have.status(200));",
              "pm.collectionVariables.set('token', pm.response.json().token);"
            ]
          }
        }
      ]
    },
    {
      "name": "3. Unauthenticated request is rejected",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/invoices",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "invoices"
          ]
        },
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('401 without token', ()=>pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "4. List invoices",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/invoices",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "invoices"
          ]
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const inv = pm.response.json().find(i=>i.vendor==='AWS Cloud Services' && i.status==='UNPAID');",
              "pm.test('seeded unpaid hosting invoice exists', ()=>pm.expect(inv).to.exist);",
              "pm.test('amountMinor is integer cents', ()=>pm.expect(inv.amountMinor).to.eql(2499));",
              "pm.collectionVariables.set('invoiceId', inv.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "5. AI: prepare hosting payment",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/ai/chat",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "ai",
            "chat"
          ]
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"message\": \"Prepare my hosting payment for this month\",\n  \"contextInvoiceId\": \"{{invoiceId}}\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const b = pm.response.json();",
              "pm.test('intent prepared', ()=>pm.expect(b.paymentIntent).to.exist);",
              "pm.collectionVariables.set('intentId', b.paymentIntent.id);",
              "pm.collectionVariables.set('intentVersion', b.paymentIntent.version);"
            ]
          }
        }
      ]
    },
    {
      "name": "6. Approve exact intent version",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/intents/{{intentId}}/approve",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "intents",
            "{{intentId}}",
            "approve"
          ]
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"intentVersion\": \"{{intentVersion}}\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('approved', ()=>pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "7. Tamper: approving with a stale version is blocked",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/intents/{{intentId}}/approve",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "intents",
            "{{intentId}}",
            "approve"
          ]
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"intentVersion\": 99\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('rejected', ()=>pm.expect(pm.response.code).to.be.oneOf([409,422]));"
            ]
          }
        }
      ]
    },
    {
      "name": "8. Create PayPal Sandbox order (needs credentials)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/payments/{{intentId}}/order",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "payments",
            "{{intentId}}",
            "order"
          ]
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('order created, or 503 when PayPal is unconfigured', ()=>pm.expect(pm.response.code).to.be.oneOf([200,503]));",
              "if (pm.response.code===200) pm.collectionVariables.set('orderId', pm.response.json().orderId);"
            ]
          }
        }
      ]
    },
    {
      "name": "9. Capturing a made-up order id is refused",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/payments/{{intentId}}/capture",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "payments",
            "{{intentId}}",
            "capture"
          ]
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"paypalOrderId\": \"FAKE-ORDER-123456\",\n  \"forceInstantCapture\": true\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('refused', ()=>pm.expect(pm.response.code).to.be.oneOf([409,503]));"
            ]
          }
        }
      ]
    },
    {
      "name": "10. Unsigned webhook is rejected",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/webhooks/paypal",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "webhooks",
            "paypal"
          ]
        },
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"event_type\": \"PAYMENT.CAPTURE.COMPLETED\",\n  \"resource\": {\n    \"id\": \"X\"\n  }\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('401', ()=>pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "11. Transactions",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/transactions",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "transactions"
          ]
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200', ()=>pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "12. Audit trail",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/audit/recent",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "audit",
            "recent"
          ]
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200', ()=>pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "13. Insights: overview",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "url": {
          "raw": "{{baseUrl}}/api/insights/overview",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "insights",
            "overview"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200', ()=>pm.response.to.have.status(200));",
              "pm.test('integer cents', ()=>pm.expect(pm.response.json().outstanding.totalMinor).to.be.a('number'));"
            ]
          }
        }
      ]
    },
    {
      "name": "14. Insights: spending by vendor",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "url": {
          "raw": "{{baseUrl}}/api/insights/spending?groupBy=vendor",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "insights",
            "spending"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200', ()=>pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "15. Transactions: search + amount filter",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "url": {
          "raw": "{{baseUrl}}/api/transactions?q=aws&minAmount=1",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "transactions"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200', ()=>pm.response.to.have.status(200));",
              "pm.test('total header', ()=>pm.expect(pm.response.headers.get('X-Total-Count')).to.exist);"
            ]
          }
        }
      ]
    },
    {
      "name": "16. Payment intents list",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "url": {
          "raw": "{{baseUrl}}/api/intents?limit=20",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "intents"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200', ()=>pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "17. Extract invoice text (unsaved draft)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "url": {
          "raw": "{{baseUrl}}/api/invoices/extract",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "invoices",
            "extract"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"text\": \"Acme Hosting Ltd\\nInvoice No: ACME-2026-0042\\nTotal due: $149.50\\nDue date: 2026-11-20\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const b = pm.response.json();",
              "pm.test('draft, not saved', ()=>{ pm.expect(b.saved).to.eql(false); pm.expect(b.draft.amount).to.eql(149.5); });"
            ]
          }
        }
      ]
    },
    {
      "name": "18. Reconcile on a non-pending intent is refused",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "url": {
          "raw": "{{baseUrl}}/api/payments/{{intentId}}/reconcile",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "payments",
            "{{intentId}}",
            "reconcile"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('409', ()=>pm.response.to.have.status(409));"
            ]
          }
        }
      ]
    }
  ]
}